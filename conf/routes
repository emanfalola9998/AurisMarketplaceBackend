# ─── conf/routes ─────────────────────────────────────────────────────────────
# Auris API routes
# CORS preflight is handled by play.filters.cors.CORSFilter (configured in application.conf)
# All API routes are under /api

# ─── Auth ─────────────────────────────────────────────────────────────────────

POST    /api/auth/sign-in               co.auris.controllers.AuthController.signIn
POST    /api/auth/sign-up               co.auris.controllers.AuthController.signUp
POST    /api/auth/refresh               co.auris.controllers.AuthController.refresh
POST    /api/auth/sign-out              co.auris.controllers.AuthController.signOut
POST    /api/auth/sign-out-all          co.auris.controllers.AuthController.signOutAll
GET     /api/auth/me                    co.auris.controllers.AuthController.me
POST    /api/auth/verify-email          co.auris.controllers.AuthController.verifyEmail
POST    /api/auth/forgot-password       co.auris.controllers.AuthController.forgotPassword
POST    /api/auth/reset-password        co.auris.controllers.AuthController.resetPassword

# ─── Surgeons — public ────────────────────────────────────────────────────────
# GET /api/surgeons/:id must come after every literal /api/surgeons/<word>
# route below — Play matches routes top-to-bottom, and a UUID-typed :id
# segment fails binding (400) on a literal path instead of falling through
# to try the next route, so any ambiguous literal segment MUST be declared
# first or it'll never be reachable.

GET     /api/surgeons                   co.auris.controllers.SurgeonController.search
POST    /api/surgeons/apply             co.auris.controllers.SurgeonController.apply

# ─── Surgeons — protected (surgeon only) ─────────────────────────────────────

PUT     /api/surgeons/profile           co.auris.controllers.SurgeonController.updateProfile
POST    /api/surgeons/profile/avatar    co.auris.controllers.SurgeonController.uploadAvatar
GET     /api/surgeons/availability      co.auris.controllers.SurgeonController.myAvailability
PUT     /api/surgeons/availability      co.auris.controllers.SurgeonController.updateAvailability
GET     /api/surgeons/dashboard         co.auris.controllers.SurgeonController.dashboard
POST    /api/surgeons/membership/subscribe co.auris.controllers.BillingController.subscribeToMembership

GET     /api/surgeons/:id               co.auris.controllers.SurgeonController.findById(id: java.util.UUID)

# ─── Patients — protected (patient only) ─────────────────────────────────────

PUT     /api/patients/onboarding        co.auris.controllers.PatientController.completeOnboarding
PUT     /api/patients/profile           co.auris.controllers.PatientController.updateProfile
GET     /api/patients/dashboard         co.auris.controllers.PatientController.dashboard
GET     /api/patients/saved             co.auris.controllers.PatientController.savedSurgeons
POST    /api/patients/saved/:surgeonId  co.auris.controllers.PatientController.saveSurgeon(surgeonId: java.util.UUID)
DELETE  /api/patients/saved/:surgeonId  co.auris.controllers.PatientController.unsaveSurgeon(surgeonId: java.util.UUID)

# ─── Enquiries ────────────────────────────────────────────────────────────────

POST    /api/enquiries                  co.auris.controllers.BookingController.createEnquiry
GET     /api/enquiries                  co.auris.controllers.BookingController.listEnquiries
PUT     /api/enquiries/:id/accept       co.auris.controllers.BookingController.acceptEnquiry(id: java.util.UUID)
PUT     /api/enquiries/:id/decline      co.auris.controllers.BookingController.declineEnquiry(id: java.util.UUID)
PUT     /api/enquiries/:id/suggest-time co.auris.controllers.BookingController.suggestAlternativeTime(id: java.util.UUID)
PUT     /api/enquiries/:id/cancel       co.auris.controllers.BookingController.cancelEnquiry(id: java.util.UUID)
PUT     /api/enquiries/:id/notes        co.auris.controllers.BookingController.addEnquiryNotes(id: java.util.UUID)

# ─── Bookings ─────────────────────────────────────────────────────────────────

POST    /api/bookings                   co.auris.controllers.BookingController.createBooking
GET     /api/bookings                   co.auris.controllers.BookingController.listBookings
GET     /api/bookings/:id               co.auris.controllers.BookingController.findBooking(id: java.util.UUID)
PUT     /api/bookings/:id/cancel        co.auris.controllers.BookingController.cancelBooking(id: java.util.UUID)
PUT     /api/bookings/:id/reschedule    co.auris.controllers.BookingController.rescheduleBooking(id: java.util.UUID)

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Unauthenticated — Stripe calls this directly; verified via webhook signature.

POST    /api/stripe/webhook              co.auris.controllers.StripeWebhookController.handle

# ─── Reviews ──────────────────────────────────────────────────────────────────

POST    /api/reviews                    co.auris.controllers.BookingController.createReview
GET     /api/surgeons/:id/reviews       co.auris.controllers.SurgeonController.reviews(id: java.util.UUID)
GET     /api/surgeons/:id/availability  co.auris.controllers.SurgeonController.availability(id: java.util.UUID)

# ─── Messages ─────────────────────────────────────────────────────────────────

GET     /api/messages                   co.auris.controllers.MessageController.inbox
POST    /api/messages                   co.auris.controllers.MessageController.send
GET     /api/messages/:userId           co.auris.controllers.MessageController.thread(userId: java.util.UUID)
PUT     /api/messages/:id/read          co.auris.controllers.MessageController.markRead(id: java.util.UUID)

# ─── Admin ────────────────────────────────────────────────────────────────────

GET     /api/admin/applications                     co.auris.controllers.AdminController.listApplications
GET     /api/admin/applications/:id                 co.auris.controllers.AdminController.getApplication(id: java.util.UUID)
PUT     /api/admin/applications/:id/approve         co.auris.controllers.AdminController.approveApplication(id: java.util.UUID)
PUT     /api/admin/applications/:id/reject          co.auris.controllers.AdminController.rejectApplication(id: java.util.UUID)
PUT     /api/admin/applications/:id/request-info    co.auris.controllers.AdminController.requestMoreInfo(id: java.util.UUID)
GET     /api/admin/surgeons                         co.auris.controllers.AdminController.listActiveSurgeons
PUT     /api/admin/surgeons/:id/suspend             co.auris.controllers.AdminController.suspendSurgeon(id: java.util.UUID)
GET     /api/admin/analytics                        co.auris.controllers.AdminController.analytics
GET     /api/admin/platform-fees                    co.auris.controllers.BillingController.listPlatformFees
PUT     /api/admin/platform-fees/:id/mark-paid      co.auris.controllers.BillingController.markFeePaidOut(id: java.util.UUID)

# ─── Uploads (local storage) ──────────────────────────────────────────────────

GET     /uploads/*file                  co.auris.controllers.UploadsController.serve(file: String)

# ─── Health check ─────────────────────────────────────────────────────────────

GET     /api/health                     co.auris.controllers.HealthController.check

